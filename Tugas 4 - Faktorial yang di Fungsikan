scanf("%d", &angka);

for ( i = 1; i <= angka; i++) {

    // printf("%d x ", i);
    
    if ( i < angka ) {
        printf("%d x ", i);
    } else {
        printf("%d ", i);
    }

    hasil *= i;

}

    printf("\nhasil dari %d! adalah %d\n", angka,  hasil);

