#include <stdio.h>
#include <windows.h>

void main() {

        SetConsoleOutputCP(CP_UTF8);

        float panjang, lebar, tinggi;

          printf("\nVolume Limas\n\n");
          printf("Panjang alas : ");
            scanf("%f", &panjang);
          printf("Lebar alas : ");
            scanf("%f", &lebar);
          printf("Tinggi : ");
            scanf("%f", &tinggi);


        float luasalas, volume;

          luasalas = panjang * lebar;
          volume = (1.0 / 3.0) * luasalas * tinggi;

        printf("\nHasil Perhitungan:\n");
        printf("Luas Alas = %.2f cm²\n", luasalas);
        printf("Volume limas = %.2f cm\u00B3\n", volume);

}
